        <mxCell id="c4Lk_tRLUIvajW80y1Jr-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0E9FF;strokeColor=#7A5AF8;strokeWidth=2;fontSize=14;fontColor=#172B4D;align=center;verticalAlign=middle;spacing=10;" value="&lt;b&gt;6. Audit Trail&lt;/b&gt;&lt;br&gt;&lt;br&gt;Investigation&lt;br&gt;Decision&lt;br&gt;Action&lt;br&gt;Reasoning + confidence + outcome&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#5E6C84&quot;&gt;Full traceability&lt;/font&gt;" vertex="1">
